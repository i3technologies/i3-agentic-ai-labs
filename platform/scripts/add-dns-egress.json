[
  {
    "op": "add",
    "path": "/spec/egress/-",
    "value": {
      "to": [
        {
          "namespaceSelector": {
            "matchLabels": {
              "kubernetes.io/metadata.name": "openshift-dns"
            }
          }
        }
      ],
      "ports": [
        {"port": 53, "protocol": "UDP"},
        {"port": 53, "protocol": "TCP"},
        {"port": 5353, "protocol": "UDP"}
      ]
    }
  }
]
