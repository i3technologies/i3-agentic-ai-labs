{
  "ci": {
    "collect": {
      "url": ["https://engage.i3technologies.co.ke/dashboard"],
      "numberOfRuns": 3,
      "settings": {
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        },
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 812,
          "deviceScaleFactor": 2
        }
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:pwa": ["error", { "minScore": 0.80 }],
        "categories:performance": ["warn",  { "minScore": 0.50 }],
        "interactive": ["error", { "maxNumericValue": 2000 }],
        "first-contentful-paint": ["warn",  { "maxNumericValue": 2000 }],
        "is-on-https": ["error", { "minScore": 1 }],
        "service-worker": ["error", { "minScore": 1 }],
        "installable-manifest": ["error", { "minScore": 1 }],
        "themed-omnibox": ["warn",  { "minScore": 1 }],
        "content-width": ["warn",  { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
