# i3 Platform — Environment Variables
# ════════════════════════════════════════════════════════════════
# HOW TO USE:
#   Copy this file to .env (already in .gitignore)
#   Fill in your real values below
#   Load in PowerShell: . .\platform\scripts\load-env.ps1
#
# NEVER commit .env to git. This template (.env.example) is safe to commit.
# ════════════════════════════════════════════════════════════════

# ── IBM Cloud ─────────────────────────────────────────────────
# Your IBM Cloud API key (from cloud.ibm.com → Manage → Access → API keys)
IBMCLOUD_API_KEY=REPLACE_WITH_YOUR_API_KEY

# ── Terraform Remote Backend (IBM COS HMAC) ───────────────────
# Generated after COS instance and HMAC credential are created.
# Run: .\platform\scripts\recover-cos.ps1 to auto-populate these.
TF_COS_ACCESS_KEY=REPLACE_AFTER_COS_SETUP
TF_COS_SECRET_KEY=REPLACE_AFTER_COS_SETUP

# ── IBM Cloud Settings ─────────────────────────────────────────
TF_VAR_region=eu-de
TF_VAR_resource_group=i3-production
TF_VAR_cluster_name=i3-platform
TF_VAR_cos_instance_name=i3-cos-production
TF_VAR_cos_bucket_name=i3-platform-077d74db
TF_VAR_worker_flavor=bx2.4x16
TF_VAR_gpu_worker_flavor=gx2.8x64
TF_VAR_min_workers=2
TF_VAR_max_workers=10

# ── Passed to Terraform as sensitive vars ─────────────────────
TF_VAR_ibmcloud_api_key=REPLACE_WITH_YOUR_API_KEY
TF_VAR_cos_hmac_access_key=REPLACE_AFTER_COS_SETUP
TF_VAR_cos_hmac_secret_key=REPLACE_AFTER_COS_SETUP

# ── KMS (Key Protect) — fill in Phase 2 ──────────────────────
# From: ibmcloud kp instance list  +  ibmcloud kp keys --instance-id <id>
TF_VAR_kms_instance_crn=REPLACE_IN_PHASE_2
TF_VAR_kms_crk_id=REPLACE_IN_PHASE_2

# ── OpenBao Unseal Keys — filled after `bao operator init` ───
# Copy 3 of the 5 Shamir keys from /tmp/openbao-init.json (NEVER commit)
# Used by: .\platform\scripts\unseal-openbao.ps1
OPENBAO_UNSEAL_KEY_1=REPLACE_AFTER_OPENBAO_INIT
OPENBAO_UNSEAL_KEY_2=REPLACE_AFTER_OPENBAO_INIT
OPENBAO_UNSEAL_KEY_3=REPLACE_AFTER_OPENBAO_INIT

# ── Onboarding Agent ──────────────────────────────────────────────
# Route all LLM calls through the LiteLLM gateway (cluster-internal)
LITELLM_URL=http://litellm-proxy.i3-litellm.svc.cluster.local:4000/v1
LITELLM_KEY=REPLACE_WITH_LITELLM_KEY
LITELLM_MODEL_FAST=granite-nano
LITELLM_MODEL_SCAN=mistral-nemo
LITELLM_MODEL_SYNTH=granite-heavy

# ChromaDB (reuse existing cluster instance)
CHROMA_HOST=chromadb.i3-admissions.svc.cluster.local
CHROMA_PORT=8000
CHROMA_TOKEN=REPLACE_WITH_CHROMA_TOKEN
CHROMA_COLLECTION=onboarding-corpus

# Keycloak SSO
KEYCLOAK_ISSUER=https://sso.i3technologies.co.ke/realms/i3
KEYCLOAK_CLIENT_ID=onboarding-agent
KEYCLOAK_JWKS_URI=https://sso.i3technologies.co.ke/realms/i3/protocol/openid-connect/certs

# EvalOS API
EVALOS_API_URL=https://evalos.i3technologies.co.ke
EVALOS_API_KEY=REPLACE_WITH_EVALOS_API_KEY

# Directus CMS
DIRECTUS_URL=https://cms.i3technologies.co.ke
DIRECTUS_TOKEN=REPLACE_WITH_DIRECTUS_TOKEN

# MCP Connectors (admissions agent cluster-internal)
MCP_CONNECTORS_URL=http://admissions-agent.i3-admissions.svc.cluster.local:8000

# n8n Onboarding Webhook
N8N_ONBOARDING_WEBHOOK_URL=https://n8n.i3technologies.co.ke/webhook/onboarding

# GitHub (for ingesting closed issues as historical context)
GITHUB_TOKEN=REPLACE_WITH_GITHUB_TOKEN

# Platform repo path (for seed corpus ingest)
PLATFORM_REPO_PATH=../platform

# Onboarding agent port
PORT=3000
