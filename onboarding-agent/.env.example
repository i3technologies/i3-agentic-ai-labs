# i3 Onboarding Agent — Environment Variables
# ════════════════════════════════════════════════════════════════
# HOW TO USE:
#   Copy this file to .env and fill in your real values.
#   Load in PowerShell: . .\platform\scripts\load-env.ps1
#   NEVER commit .env — it is in .gitignore.
# ════════════════════════════════════════════════════════════════

# ── GitHub (for ingesting the platform repo) ──────────────────
GITHUB_TOKEN=REPLACE_WITH_YOUR_GITHUB_PAT
GITHUB_OWNER=i3-technologies
GITHUB_REPO=platform-gitops

# ── LiteLLM Gateway (i3 sovereign model router) ───────────────
# Cluster-internal (when running inside ROKS):
LITELLM_URL=http://litellm-proxy.i3-model-gateway.svc.cluster.local:4000
# External (when running locally against the cluster):
# LITELLM_URL=https://litellm.i3technologies.co.ke/v1
LITELLM_KEY=REPLACE_WITH_LITELLM_MASTER_KEY

# Model aliases (mapped in litellm-deploy.yaml)
LITELLM_MODEL_FAST=granite-nano       # Tier 3 — verification passes, quick tasks
LITELLM_MODEL_SCAN=mistral-nemo       # Tier 2 — subagent scans, RAG reasoning
LITELLM_MODEL_SYNTH=granite-heavy     # Tier 1 — final plan synthesis

# ── ChromaDB (existing i3-admissions instance) ────────────────
# Cluster-internal:
CHROMA_HOST=chromadb.i3-admissions.svc.cluster.local
CHROMA_PORT=8000
CHROMA_TOKEN=REPLACE_WITH_CHROMA_TOKEN
# Onboarding collection name (separate from admissions-docs):
CHROMA_COLLECTION=onboarding-corpus

# ── Keycloak SSO ──────────────────────────────────────────────
KEYCLOAK_ISSUER=https://sso.i3technologies.co.ke/realms/i3
KEYCLOAK_CLIENT_ID=onboarding-agent
KEYCLOAK_JWKS_URI=https://sso.i3technologies.co.ke/realms/i3/protocol/openid-connect/certs

# ── EvalOS API (for evalos-scan subagent) ─────────────────────
EVALOS_API_URL=http://evalos-api.i3-evalos.svc.cluster.local:8080
EVALOS_API_KEY=REPLACE_WITH_EVALOS_SERVICE_KEY

# ── Directus CMS (for curriculum ingestion) ───────────────────
DIRECTUS_URL=https://cms.i3technologies.co.ke
DIRECTUS_TOKEN=REPLACE_WITH_DIRECTUS_STATIC_TOKEN

# ── MCP Connectors (existing i3-admissions service) ───────────
MCP_CONNECTORS_URL=http://mcp-connectors.i3-admissions.svc.cluster.local:8001

# ── n8n Automation webhook ────────────────────────────────────
N8N_ONBOARDING_WEBHOOK_URL=https://n8n.i3technologies.co.ke/webhook/onboarding-trigger
N8N_WEBHOOK_TOKEN=REPLACE_WITH_N8N_WEBHOOK_TOKEN

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Platform repo path (for local file-walk ingestion) ────────
PLATFORM_REPO_PATH=../platform
