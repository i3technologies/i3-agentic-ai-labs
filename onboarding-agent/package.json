{
  "name": "i3-onboarding-agent",
  "version": "1.0.0",
  "description": "i3 Technologies Codebase Onboarding Agent — IBM TechXchange 2026 Hackathon",
  "main": "dist/server.js",
  "scripts": {
    "build":          "tsc",
    "start":          "node dist/server.js",
    "dev":            "ts-node src/server.ts",
    "ingest":         "ts-node src/ingestion/platform.ts",
    "ingest:github":  "ts-node src/ingestion/github.ts",
    "test":           "jest --runInBand",
    "lint":           "eslint src --ext .ts",
    "typecheck":      "tsc --noEmit",
    "mock:litellm":   "node scripts/mock-litellm.mjs",
    "chroma":         "npx --yes chromadb@latest",
    "test:local":     "powershell -File scripts/test-local.ps1"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "chromadb": "^1.9.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.52.0",
    "simple-git": "^3.25.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
